item.flame_demon_eye.name=Flame Demon Eye
item.flame_demon_eye.desc=Flame Demon Eye: More missing HP grants more damage and speed; triggers Undying (7s, 300s cd) at lethal; toggle "Play with Fire"
item.flame_demon_eye.toggle_on=Play with Fire: ON (+50%% damage, take 35%% self-damage)
item.flame_demon_eye.toggle_off=Play with Fire: OFF
item.flame_demon_eye.cooldown=§aUndying on cooldown
item.flame_demon_eye.ready=§aUndying ready
item.skyfeather_amulet.name=Skyfeather Amulet
item.skyfeather_amulet.desc=§bContains remnants of the Wind God's consciousness, providing great power in times of crisis
item.skyfeather_amulet.ready=§aReady
item.skyfeather_amulet.cooldown=§cThe divine consciousness is reforming
item.wind_ring.name=Ring of Zephyr
item.wind_ring.desc=§7Press [G] to fire a wind arrow that pierces through everything.
item.wind_ring.cooldown=§7(Shared cooldown 60s)
item.wind_amulet.name=Wind Amulet
item.wind_amulet.desc=§7Contains weak wind power that may activate when threatened
item.wind_attraction_ring.name=Wind Attraction Ring
item.wind_attraction_ring.desc=§7When killing enemy creatures, attracts nearby enemies to the death location
item.crack_wind_ring.name=Crack Wind Ring
item.crack_wind_ring.desc=§7+20%% bow speed; +20%% arrow speed, deals 20%% chain damage to enemies behind target
item.wind_shadow_belt.name=Wind Shadow Belt
item.wind_shadow_belt.desc=§7After sprinting for 10 seconds, gain Wind State: +30%% speed, +1 jump, 15%% dodge chance; gain 1 Wind Mark every 7 seconds (max 5), +3%% speed per mark, converts to wind shield when taking damage
item.wind_crown.name=Wind Crown
item.wind_crown.desc=§bThe crown of the Wind, containing powerful wind energy
item.wind_crown.shield_info=§7Gain wind shield of 50%% health
item.wind_crown.projectile_info=§7Wind shield absorbs 40%% melee damage and 70%% projectile damage
item.wind_crown.regen_info=§7Shield cannot regenerate for 40 seconds after breaking
item.wind_shield_echo.name=Wind Shield Echo
item.wind_shield_echo.desc=§b15%% chance to generate wind shield when taking damage
item.wind_shield_echo.probability=§7Probability triggers wind shield defense
item.wind_shield_echo.immunity=§7Immune to next damage for 5 seconds
item.wind_shield_echo.reflection=§7Reflects immune damage back to attacker
item.wind_shield_echo.area_damage=§7Deals 10 area damage to enemies around attacker
item.wind_charm.name=Wind Charm
item.wind_charm.desc=§7After equipping, you can press the jump button to step on the wind at any time after jumping. You can also enhance this behavior by leaning against the wall. Each jump increases in height (up to +8 squares)

item.wind_spirit.name=Wind Spirit
item.wind_spirit.desc=§bContains indescribable wind power, you can feel every subtle breeze from all directions
item.wind_spirit.effect_title=§6Wind Spirit Enhancement Effects:
item.wind_spirit.wind_amulet_boost=§7Wind Amulet: Additional +5%% speed, trigger threshold -20%%
item.wind_spirit.skyfeather_boost=§7Skyfeather: Additional +5%% speed, launch height +20%%, knockback damage +20%%, protection time +4s
item.wind_spirit.wind_ring_boost=§7Wind Ring: Max health damage becomes 33%%
item.wind_spirit.wind_attraction_boost=§7Wind Attraction Ring: Attraction duration +0.5s
item.wind_spirit.crack_wind_boost=§7Crack Wind Ring: Additional +10%% bow speed, penetration area damage becomes 35%%
item.wind_spirit.wind_shadow_belt_boost=§7Wind Shadow Belt: Wind state dodge +5%%, wind mark damage reduction becomes 18%%
item.wind_spirit.wind_crown_boost=§7Wind Crown: Max health shield becomes 75%%
item.wind_spirit.wind_shield_echo_boost=§7Wind Shield Echo: Damage dealt becomes 16 points
item.wind_spirit.wind_charm_boost=§7Wind Charm: Each jump height increment changes from 1 block to 2 blocks

item.flame_demon_core.name=Flame Demon Core
item.flame_demon_core.desc=§7Fire resistance; attacks ignite targets (5s burn, 1%% max HP/s, 30s cd/target); +20%% speed in lava and on soul sand

item.explosion_ring.name=Explosion Ring
item.explosion_ring.desc=§7[G] Ignite self, explode after 3s: 80%% max HP true dmg to self, 180%% to nearby enemies (4 block radius, 180s cd)
item.explosion_ring.armed=§cFUSE LIT — Detonating in 3s!
item.explosion_ring.cooldown=§cExplosion on cooldown
item.explosion_ring.ready=§aExplosion ready

item.ash_ring.name=Ash Ring
item.ash_ring.desc=§7Below 50%% HP: deal fire damage equal to 100%% of your missing HP to nearby enemies (30s cd)

item.soul_burn_ring.name=Soul Burn Ring
item.soul_burn_ring.desc=§7When attacked: fire chain links to attacker, draining 3%% current HP (max 5) every 2s (heals you; overflow→absorption shield); attacker cannot heal; 14s duration, breaks beyond 20 blocks (90s cd/target)

item.lava_heart_belt.name=Lava Heart Belt
item.lava_heart_belt.desc=§7+25%% max HP; while in lava: regen 1 HP/s + Resistance I (expires immediately on leaving lava)

item.ember_mask.name=Ember Mask
item.ember_mask.desc=§7Night vision; stare at a hostile mob 6s to ignite it (10s); stare at a burning mob 5s to instantly deal all remaining burn damage (1 dmg/s remaining) and extinguish it

item.fervent_cloak.name=Fervent Cloak
item.fervent_cloak.desc=§7Aura: nearby enemies burn (1 fire dmg/s, -10%% healing); on kill: small explosion dealing 10 dmg to nearby enemies (30s cd)

item.explosion_pendant.name=Explosion Pendant
item.explosion_pendant.desc=§7When a single hit exceeds 55%% of a mob's max HP, trigger a small explosion igniting nearby mobs and dealing 7 damage

item.fire_spirit.name=Fire Spirit
item.fire_spirit.desc=§bContains indescribable fire power; you can feel every faint ember from all directions
item.fire_spirit.effect_title=§6Fire Spirit Enhancement Effects:
item.fire_spirit.flame_demon_eye_boost=§7Flame Demon Eye: Berserker max bonus +15%% (atk 50%%→65%%, spd 20%%→28%%), Undying +3s (7s→10s)
item.fire_spirit.flame_demon_core_boost=§7Flame Demon Core: Burn duration +3s (5s→8s), ignite cooldown halved (30s→15s)
item.fire_spirit.explosion_ring_boost=§7Explosion Ring: Cooldown -60s (180s→120s), self-damage ratio 80%%→60%%
item.fire_spirit.ash_ring_boost=§7Ash Ring: Trigger threshold 50%%→65%%, damage multiplier 100%%→130%% of missing HP
item.fire_spirit.soul_burn_ring_boost=§7Soul Burn Ring: Chain duration +6s (14s→20s), drain cap 5→8
item.fire_spirit.lava_heart_belt_boost=§7Lava Heart Belt: Max HP bonus 25%%→40%%, lava regen 1→2 HP/s
item.fire_spirit.ember_mask_boost=§7Ember Mask: Ignite stare 6s→4s, burn detonation stare 5s→3s
item.fire_spirit.fervent_cloak_boost=§7Fervent Cloak: Aura range +1 block (2→3), kill explosion dmg 10→15, cooldown 30s→20s
item.fire_spirit.explosion_pendant_boost=§7Explosion Pendant: Trigger threshold 55%%→40%%, explosion damage 7→12

